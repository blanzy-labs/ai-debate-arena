# Mythadis AI Debate Arena local configuration
# Copy this file to .env for local development.
# Never commit .env with real provider keys.

OPENAI_API_KEY=
GEMINI_API_KEY=

OPENAI_MODEL=gpt-4.1-mini
GEMINI_MODEL=gemini-2.5-flash

# Frontend browser API base URL.
# This is not a secret and must not contain provider API keys.
VITE_API_BASE_URL=http://localhost:8000
